// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(uuid())
  name           String
  status         String   @default("queue")
  senha          String
  sector         String
  isPreferencial Boolean  @default(false)
  celphone       String?
  email          String?
  seat           Int? // cadeira (0-15) ocupada quando status = "waiting"
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  senhaDate      DateTime @default(now()) // Track the date when senha was assigned

  @@index([name, sector]) // dedupe check no POST /user
  @@index([senhaDate]) // count do dia + filtro do GET
  @@index([status]) // filtro da listagem
  @@index([createdAt]) // ordenação das listagens
}

// A manually blocked chair (e.g. a companion sitting on it) — no senha, not in
// the queue. One row per blocked seat; day-scoped like the rest of the app.
model SeatBlock {
  seat        Int      @id // cadeira 0-15
  blockedDate DateTime @default(now())

  @@index([blockedDate])
}
